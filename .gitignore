# pyenv
#   For a library or package, you might want to ignore these files since the user is
#   expected to provide their own. For an app, this contains the specific version.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if used in a clean env:
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock contains exact dependency versions.
#poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock contains exact dependency versions.
#pdm.lock

# PEP 582; project local packages directory (used by pdm)
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

